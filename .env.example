# Copie este arquivo para ".env" e preencha os valores.

# Porta em que o servidor de teste vai escutar
PORT=3000

# Segredo usado para assinar o cookie de sessão.
# Gere um valor com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# Chave que o painel do administrador (/admin) precisa informar para
# listar, aprovar e rejeitar cadastros. Gere com o mesmo comando acima
# (use um valor DIFERENTE do SESSION_SECRET).
ADMIN_SECRET=

# Opcional. Pasta onde o banco SQLite (usuários, respostas e sessões) é
# gravado. Deixe em branco para usar a pasta "data/" local (bom para testar
# no seu computador). Em produção no Render, aponte para o caminho do
# Persistent Disk (ex.: /var/data) para os dados NÃO serem apagados a cada
# novo deploy ou reinício do serviço.
DATA_DIR=
